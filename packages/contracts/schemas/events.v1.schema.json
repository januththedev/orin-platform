{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orinai.org/platform/1.0.0/events.v1.schema.json",
  "$defs": {
    "EventEnvelopeV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event_id", "type", "occurred_at", "product", "source", "request_id", "trace_id", "correlation_id", "account_id", "session_id", "run_id", "outcome", "duration_ms", "error_code", "redacted_metadata"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "event_id": { "$ref": "common.v1.schema.json#/$defs/OpaqueIdV1" },
        "type": { "type": "string", "pattern": "^orin\\.[a-z0-9_.-]+$" },
        "occurred_at": { "$ref": "common.v1.schema.json#/$defs/TimestampV1" },
        "product": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "component"],
          "properties": { "service": { "type": "string" }, "component": { "type": "string" }, "instance_id": { "type": "string" } }
        },
        "request_id": { "$ref": "common.v1.schema.json#/$defs/RequestIdV1" },
        "trace_id": { "$ref": "common.v1.schema.json#/$defs/TraceIdV1" },
        "correlation_id": { "$ref": "common.v1.schema.json#/$defs/RequestIdV1" },
        "account_id": { "anyOf": [{ "$ref": "common.v1.schema.json#/$defs/AccountIdV1" }, { "type": "null" }] },
        "session_id": { "anyOf": [{ "$ref": "common.v1.schema.json#/$defs/OpaqueIdV1" }, { "type": "null" }] },
        "run_id": { "anyOf": [{ "$ref": "common.v1.schema.json#/$defs/OpaqueIdV1" }, { "type": "null" }] },
        "outcome": { "enum": ["started", "succeeded", "failed", "denied", "cancelled"] },
        "duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "error_code": { "type": ["string", "null"] },
        "redacted_metadata": { "type": "object", "maxProperties": 32, "propertyNames": { "not": { "pattern": "prompt|response|content|token|secret|authorization|cookie|email|query|path|file" } }, "additionalProperties": { "type": ["string", "number", "boolean", "null"] } }
      }
    }
  }
}
