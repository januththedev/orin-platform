{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.orinai.org/platform/1.0.0/router.v1.schema.json",
  "$defs": {
    "ChatRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "messages"],
      "properties": {
        "model": { "$ref": "models.v1.schema.json#/$defs/ModelAliasV1" },
        "messages": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "type": "object", "additionalProperties": false, "required": ["role", "content"], "properties": { "role": { "enum": ["system", "user", "assistant"] }, "content": { "type": "string", "maxLength": 200000 } } } },
        "stream": { "type": "boolean" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "ImageGenerationRequestV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt", "n", "response_format"],
      "properties": {
        "model": { "$ref": "models.v1.schema.json#/$defs/ModelAliasV1" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "n": { "const": 1 },
        "size": { "enum": ["512x512", "768x768", "1024x1024"] },
        "response_format": { "const": "b64_json" }
      }
    }
  }
}
